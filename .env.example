# Copy this file to .env (same folder) and fill in the values. .env is gitignored and never committed.
# The process environment takes priority over this file.

# Telegram alerts. Bot token: from @BotFather (after /revoke, use the NEW token). Chat id: run
#   .venv\Scripts\python.exe -m prop_alpha.alerts.telegram --get-chat-id
# after sending /start to your bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Active runtime data source: scheduled results, scans and team-sheet capture use TheStatsAPI.
# The trial is recorded in CLAUDE.md as ending 2026-10-20; verify access and plan terms before relying on it.
THESTATSAPI_KEY=
# Optional request-rate override (default 0.19 requests/second).
# THESTATSAPI_RPS=0.19

# Legacy ingestion tools only. build_vendor_client supports Sportmonks (default) and generic payloads;
# current scheduled TheStatsAPI workflows use the listing-aware build_thestatsapi_client instead.
SPORTMONKS_API_TOKEN=
# DATA_VENDOR=sportmonks

# Odds: ODDSPAPI_KEY is read by the opportunity scan (--odds oddspapi). Optional: ODDS_BOOKMAKERS
# (default bet365,skybet,williamhill) and ODDS_MAX_REQUESTS (default 8 per run).
ODDSPAPI_KEY=


# Bankroll currency (required): GBP or USD. Book limits are taken as GBP; with USD the scan converts them at the
# ECB rate cached by python -m prop_alpha.alerts.fx --refresh.
PROP_ALPHA_CURRENCY=USD

# Daily backup (scripts\backup.cmd, task "prop_alpha\Daily backup"). PROP_ALPHA_BACKUP_DIR: local folder for the
# verified backups (default .prop_alpha_state\backups\daily; a folder set here must exist).
# PROP_ALPHA_BACKUP_GIT_REMOTE: https://github.com/<owner>/<repo>.git of a PRIVATE repository that holds only backups
# (never the code repository); the push refuses a public one. Unset: the backup stays on this machine and the task
# fails.
PROP_ALPHA_BACKUP_DIR=
PROP_ALPHA_BACKUP_GIT_REMOTE=
