# Copy this file to .env (same folder) and fill in the values. .env is gitignored and never committed.
# The process environment takes priority over this file.

# Telegram alerts. Bot token: from @BotFather (after /revoke, use the NEW token). Chat id: run
#   .venv\Scripts\python.exe -m prop_alpha.alerts.telegram --get-chat-id
# after sending /start to your bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Match statistics for ingestion (DATA_VENDOR=sportmonks, the default).
SPORTMONKS_API_TOKEN=

# Odds data: no code reads these yet (the odds poller is not built).
THE_ODDS_API_KEY=
ODDSPAPI_KEY=

# Not used by ingestion: API-Football has no adapter.
API_FOOTBALL_KEY=
